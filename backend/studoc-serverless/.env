# ===================================================
# 🌍 AWS / Cognito Konfiguration
# ===================================================
AWS_REGION=us-east-1

# --- Cognito User Pool ---
COGNITO_USER_POOL_ID=us-east-1_Y9732eTGf
COGNITO_CLIENT_ID=67d491bms2kc7k1lkq8ugs6fm8
COGNITO_DOMAIN=mydemoapp20251202.auth.us-east-1.amazoncognito.com

# --- Redirects (Frontend OAuth2 Flow) ---
REDIRECT_URI=http://localhost:5173/callback
LOGOUT_URI=http://localhost:5173

# ===================================================
# ⚙️ Backend API (Lambda + API Gateway)
# ===================================================
# Lokales Backend (z. B. für serverless offline)
# VITE_API_BASE=http://localhost:3000/api

# Deploy-Backend (nach serverless deploy)
# 👇 Wichtig: API-Gateway-Endpunkt deiner neuen Dev-API
VITE_API_BASE=https://vbkh5c3abb.execute-api.us-east-1.amazonaws.com

# ===================================================
# 💾 Datenbanken / Storage (DynamoDB + S3)
# ===================================================
# Modulübersicht (z. B. Informatik, BWL etc.)
MODULES_TABLE_NAME=StuDoc-Modules_dev

# Dateispeicher (Verknüpfung Modul <-> Datei)
FILES_TABLE_NAME=StuDoc-Files_dev

# Benutzerprofile (optional für spätere Features)
USERS_TABLE_NAME=StuDoc-Users_dev

# Gruppenberechtigungen (Mapping: groupName ↔ moduleId)
GROUP_ACCESS_TABLE_NAME=StuDoc-GroupAccess_dev

# AWS S3-Bucket für Datei-Uploads
S3_BUCKET_NAME=studoc-files-bucket

# ===================================================
# 🔐 Berechtigungen / Gruppenzugriff (Cognito)
# ===================================================
# Standardrollen
DEFAULT_ALLOWED_GROUPS=Admins,Dozenten
DEFAULT_READONLY_GROUPS=Studenten

# Optional: Standardmodulzugriff (falls gewünscht)
DEFAULT_MODULE_ACCESS=read
