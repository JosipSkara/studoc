    "serviceRawFile": "service: studoc-groups-api\r\nframeworkVersion: 3\r\nuseDotenv: true\r\n\r\n# ----------------------------------------------------\r\n# ⚙️ Globale Konfiguration\r\n# ----------------------------------------------------\r\ncustom:\r\n  stage: ${opt:stage, 'dev'}\r\n  userPoolId: us-east-1_djyDpSa8G\r\n  userPoolClientId: 1rdf9r0u75i0hnl6f4agnh0mug\r\n\r\nprovider:\r\n  name: aws\r\n  runtime: nodejs20.x\r\n  stage: ${self:custom.stage}\r\n  region: us-east-1\r\n  role: arn:aws:iam::992382686388:role/LabRole\r\n\r\n  # ------------------------------------------------\r\n  # 🌍 Environment Variablen (für Lambdas)\r\n  # ------------------------------------------------\r\n  environment:\r\n    USER_POOL_ID: ${self:custom.userPoolId}\r\n    USER_POOL_CLIENT_ID: ${self:custom.userPoolClientId}\r\n\r\n    MODULES_TABLE_NAME: StuDoc-Modules_${self:custom.stage}\r\n    FILES_TABLE_NAME: StuDoc-Files_${self:custom.stage}\r\n    USERS_TABLE_NAME: StuDoc-Users_${self:custom.stage}\r\n    GROUP_ACCESS_TABLE_NAME: StuDoc-GroupAccess_${self:custom.stage}\r\n\r\n    DEFAULT_ALLOWED_GROUPS: Admins,Dozenten\r\n    DEFAULT_READONLY_GROUPS: Studenten\r\n\r\n  # ------------------------------------------------\r\n  # 🔑 HTTP API + Cognito JWT Authorizer + CORS\r\n  # ------------------------------------------------\r\n  httpApi:\r\n    cors:\r\n      allowedOrigins:\r\n        - http://localhost:5173\r\n        - https://studoc.ch\r\n        - https://www.studoc.ch\r\n      allowedHeaders:\r\n        - Content-Type\r\n        - Authorization\r\n        - X-Amz-Date\r\n        - X-Api-Key\r\n        - X-Amz-Security-Token\r\n      allowedMethods:\r\n        - OPTIONS\r\n        - GET\r\n        - POST\r\n        - PUT\r\n        - DELETE\r\n      allowCredentials: false\r\n\r\n    authorizers:\r\n      StuDocCognitoAuthorizer:\r\n        type: jwt\r\n        identitySource: \"$request.header.Authorization\"\r\n        issuerUrl: https://cognito-idp.${self:provider.region}.amazonaws.com/${self:custom.userPoolId}\r\n        audience:\r\n          - ${self:custom.userPoolClientId}\r\n\r\n# ----------------------------------------------------\r\n# 💻 Lambda Funktionen (API Endpoints)\r\n# ----------------------------------------------------\r\nfunctions:\r\n  # ---------------- Modules ----------------\r\n  listModules:\r\n    handler: handlers/listModules.handler\r\n    events:\r\n      - httpApi:\r\n          path: /modules\r\n          method: get\r\n          authorizer: StuDocCognitoAuthorizer\r\n\r\n  createModule:\r\n    handler: handlers/createModule.handler\r\n    events:\r\n      - httpApi:\r\n          path: /modules\r\n          method: post\r\n          authorizer: StuDocCognitoAuthorizer\r\n\r\n  listModuleFiles:\r\n    handler: handlers/listModuleFiles.handler\r\n    events:\r\n      - httpApi:\r\n          path: /modules/{moduleId}/files\r\n          method: get\r\n          authorizer: StuDocCognitoAuthorizer\r\n\r\n  uploadFileToModule:\r\n    handler: handlers/uploadFileToModule/index.handler\r\n    events:\r\n      - httpApi:\r\n          path: /modules/{moduleId}/files\r\n          method: post\r\n          authorizer: StuDocCognitoAuthorizer\r\n      # Kein eigenes OPTIONS-Event nötig → handled by withCors()\r\n\r\n  # ---------------- Groups ----------------\r\n  listGroups:\r\n    handler: handlers/listGroups.handler\r\n    events:\r\n      - httpApi:\r\n          path: /groups\r\n          method: get\r\n          authorizer: StuDocCognitoAuthorizer\r\n\r\n  createGroup:\r\n    handler: handlers/createGroup.handler\r\n    events:\r\n      - httpApi:\r\n          path: /groups\r\n          method: post\r\n          authorizer: StuDocCognitoAuthorizer\r\n\r\n  deleteGroup:\r\n    handler: handlers/deleteGroup.handler\r\n    events:\r\n      - httpApi:\r\n          path: /groups/{groupName}\r\n          method: delete\r\n          authorizer: StuDocCognitoAuthorizer\r\n\r\n  listGroupMembers:\r\n    handler: handlers/listGroupMembers.handler\r\n    events:\r\n      - httpApi:\r\n          path: /groups/{groupName}/members\r\n          method: get\r\n          authorizer: StuDocCognitoAuthorizer\r\n\r\n  addUserToGroup:\r\n    handler: handlers/addUserToGroup.handler\r\n    events:\r\n      - httpApi:\r\n          path: /groups/{groupName}/members\r\n          method: post\r\n          authorizer: StuDocCognitoAuthorizer\r\n\r\n  removeUserFromGroup:\r\n    handler: handlers/removeUserFromGroup.handler\r\n    events:\r\n      - httpApi:\r\n          path: /groups/{groupName}/members/{username}\r\n          method: delete\r\n          authorizer: StuDocCognitoAuthorizer\r\n\r\n  # ---------------- Users ----------------\r\n  listAllUsers:\r\n    handler: handlers/listAllUsers.handler\r\n    events:\r\n      - httpApi:\r\n          path: /users\r\n          method: get\r\n          authorizer: StuDocCognitoAuthorizer\r\n\r\n# ----------------------------------------------------\r\n# 🗄️ DynamoDB Tabellen (automatisch erstellt)\r\n# ----------------------------------------------------\r\nresources:\r\n  Resources:\r\n    StuDocUploadsBucket:\r\n      Type: AWS::S3::Bucket\r\n      Properties:\r\n        BucketName: studoc-files-bucket\r\n        AccessControl: Private\r\n        VersioningConfiguration:\r\n          Status: Enabled\r\n    StuDocModulesTable:\r\n      Type: AWS::DynamoDB::Table\r\n      Properties:\r\n        TableName: StuDoc-Modules_${self:custom.stage}\r\n        AttributeDefinitions:\r\n          - AttributeName: moduleId\r\n            AttributeType: S\r\n        KeySchema:\r\n          - AttributeName: moduleId\r\n            KeyType: HASH\r\n        BillingMode: PAY_PER_REQUEST\r\n        SSESpecification:\r\n          SSEEnabled: true\r\n\r\n    StuDocFilesTable:\r\n      Type: AWS::DynamoDB::Table\r\n      Properties:\r\n        TableName: StuDoc-Files_${self:custom.stage}\r\n        AttributeDefinitions:\r\n          - AttributeName: fileId\r\n            AttributeType: S\r\n          - AttributeName: moduleId\r\n            AttributeType: S\r\n        KeySchema:\r\n          - AttributeName: fileId\r\n            KeyType: HASH\r\n        GlobalSecondaryIndexes:\r\n          - IndexName: moduleId-index\r\n            KeySchema:\r\n              - AttributeName: moduleId\r\n                KeyType: HASH\r\n            Projection:\r\n              ProjectionType: ALL\r\n        BillingMode: PAY_PER_REQUEST\r\n        SSESpecification:\r\n          SSEEnabled: true\r\n\r\n    StuDocUsersTable:\r\n      Type: AWS::DynamoDB::Table\r\n      Properties:\r\n        TableName: StuDoc-Users_${self:custom.stage}\r\n        AttributeDefinitions:\r\n          - AttributeName: userId\r\n            AttributeType: S\r\n        KeySchema:\r\n          - AttributeName: userId\r\n            KeyType: HASH\r\n        BillingMode: PAY_PER_REQUEST\r\n        SSESpecification:\r\n          SSEEnabled: true\r\n\r\n    StuDocGroupAccessTable:\r\n      Type: AWS::DynamoDB::Table\r\n      Properties:\r\n        TableName: StuDoc-GroupAccess_${self:custom.stage}\r\n        AttributeDefinitions:\r\n          - AttributeName: groupName\r\n            AttributeType: S\r\n          - AttributeName: moduleId\r\n            AttributeType: S\r\n        KeySchema:\r\n          - AttributeName: groupName\r\n            KeyType: HASH\r\n          - AttributeName: moduleId\r\n            KeyType: RANGE\r\n        GlobalSecondaryIndexes:\r\n          - IndexName: moduleId-index\r\n            KeySchema:\r\n              - AttributeName: moduleId\r\n                KeyType: HASH\r\n            Projection:\r\n              ProjectionType: ALL\r\n        BillingMode: PAY_PER_REQUEST\r\n        SSESpecification:\r\n          SSEEnabled: true\r\n",
    "command": [
      "deploy",
      "function"
    ],
    "options": {
      "function": "deleteGroup"
    },
